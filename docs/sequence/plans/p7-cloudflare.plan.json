      "kind": "source"
    },
    {
      "id": "queue-command",
      "label": "Authorize and queue controller command",
      "locator": "cloudflare/relay/src/device_relay.ts::DeviceRelay.queueCommand",
      "kind": "source"
    },
    {
      "id": "protocol-verify",
      "label": "Protocol-v1 authority checks",
      "locator": "cloudflare/relay/src/protocol.ts::verifySignedCommand",
      "kind": "source"
    },
    {
      "id": "deliver-head",
      "label": "Deliver FIFO head",
      "locator": "cloudflare/relay/src/device_relay.ts::DeviceRelay.deliverHead",
      "kind": "source"
    },
    {
      "id": "local-agent",
