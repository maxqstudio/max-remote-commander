      "verification": "SOURCE"
    },
    {
      "from": "result-store",
      "to": "controller-result",
      "action": "acknowledge result only after durable write succeeds",
      "requirement": "MUST",
      "verification": "SOURCE"
    },
    {
      "from": "worker-entry",
      "to": "local-agent",
      "action": "direct remote execution bypass",
