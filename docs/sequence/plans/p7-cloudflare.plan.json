  "edges": [
    {
      "from": "worker-entry",
      "to": "device-do",
      "action": "route by validated device id through Durable Object binding",
      "requirement": "MUST",
      "verification": "SOURCE"
    },
    {
      "from": "device-do",
      "to": "queue-command",
      "action": "dispatch authenticated controller command request",
      "requirement": "MUST",
      "verification": "SOURCE"
    },
    {
      "from": "queue-command",
      "to": "protocol-verify",
      "action": "verify controller device generation session expiry and replay authority before storage",
      "requirement": "MUST",
      "verification": "SOURCE"
    },
    {
      "from": "queue-command",
      "to": "deliver-head",
      "action": "after durable commit attempt delivery of FIFO head",
      "requirement": "MUST",
      "verification": "SOURCE"
    },
    {
      "from": "deliver-head",
      "to": "local-agent",
      "action": "send unchanged signed CommandEnvelope through authenticated Hibernation WebSocket",
      "requirement": "MUST",
      "verification": "DOCUMENT"
    },
    {
      "from": "local-agent",
      "to": "submit-result",
      "action": "submit bounded result under active paired device session",
      "requirement": "MUST",
      "verification": "DOCUMENT"
    },
    {
      "from": "device-do",
      "to": "submit-result",
      "action": "dispatch authenticated device result request",
      "requirement": "MUST",
      "verification": "SOURCE"
    },
    {
      "from": "device-do",
      "to": "controller-result",
      "action": "dispatch authenticated controller result wait",
      "requirement": "MUST",
      "verification": "SOURCE"
    },
    {
      "from": "worker-entry",
      "to": "local-agent",
      "action": "direct remote execution bypass",
      "requirement": "MUST_NOT",
      "verification": "SOURCE"
    }
  ]
