{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maxrc-p7-ci-only",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "durable_objects": {
    "bindings": [
      {
        "name": "DEVICE_RELAY",
        "class_name": "DeviceRelay"
      }
    ]
  },
  "migrations": [
    {
      "tag": "p7-sqlite-001",
      "new_sqlite_classes": [
        "DeviceRelay"
      ]
    }
  ],
  "workers_dev": false,
  "vars": {
    "PAIRING_BOOTSTRAP_SECRET": "ci-fixture-nonproduction-bootstrap-token-64-bytes-1234567890123456"
  }
}
